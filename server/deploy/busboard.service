# systemd *user* unit (busbox has linger enabled, so it runs without anyone logged in).
# Installed by deploy.sh to ~/.config/systemd/user/busboard.service
[Unit]
Description=Bus departure board server (GTFS -> departures JSON/BMP, UCOP comparison)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/busboard
ExecStart=%h/.local/bin/uv run --frozen --no-dev uvicorn busboard.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
